---
// SearchFilter.astro — pure static HTML search bar.
// Filtering logic is handled by vanilla JS in index.astro.
import { Icon } from 'astro-icon/components';
---

<section class="pt-12 pb-7 px-2 text-center max-w-2xl mx-auto w-full">
  <!-- Page heading -->
  <h1 class="text-text-primary tracking-tight text-3xl sm:text-4xl font-bold leading-tight pb-3">
    أدوات عملية وبسيطة، في مكان واحد
  </h1>
  <p class="text-text-secondary text-sm sm:text-base font-normal leading-relaxed pb-7 text-center">
    مجموعة أدوات مفيدة وسريعة، مُصممة للتركيز والعمل المباشر دون تعقيد.
  </p>

  <!-- Search Input -->
  <div class="relative w-full text-start">
    <label class="sr-only" for="toolSearchInput">ابحث عن أداة</label>

    <div class="relative flex items-center w-full h-14 rounded-2xl border border-border bg-canvas focus-within:border-accent focus-within:ring-2 focus-within:ring-accent/10 transition-all">
      <!-- Search icon — RTL: placed at the start (right) of the input -->
      <div class="flex items-center justify-center ps-4 pe-2 text-text-secondary pointer-events-none shrink-0" aria-hidden="true">
        <Icon name="lucide:search" class="size-5" />
      </div>

      <!-- Input field -->
      <input
        id="toolSearchInput"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder="ابحث عن أداة... (مثلاً: حساب العمر، ضغط الصور، نسبة مئوية)"
        class="w-full h-full bg-transparent border-0 text-text-primary placeholder:text-text-secondary text-sm sm:text-base font-normal focus:ring-0 focus:outline-none pe-20"
        aria-label="ابحث عن أداة"
      />

      <!-- Clear button — hidden until input has value -->
      <div class="absolute inset-e-3 flex items-center gap-2">
        <button
          id="searchClearBtn"
          type="button"
          aria-label="مسح البحث"
          class="hidden p-1 text-text-secondary hover:text-text-primary rounded-md transition-colors"
        >
          <Icon name="lucide:x" class="size-4" />
        </button>
        <kbd class="hidden sm:inline-flex items-center px-2 py-0.5 text-[11px] text-text-secondary font-medium bg-surface border border-border rounded-lg">
          ESC
        </kbd>
      </div>
    </div>
  </div>
</section>
