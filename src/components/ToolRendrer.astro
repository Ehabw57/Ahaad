---
import AgeCalculator from "../tools/age-calculator/AgeCalculator";
import QrGenerator from "../tools/qr-generator/QrGenerator";
import ImageCompressor from "../tools/image-compressor/ImageCompressor";
import DocumentScanner from "../tools/document-scanner/DocumentScanner";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

{
  slug === "age-calculator" ? (
    <AgeCalculator client:load />
  ) : slug === "qr-generator" ? (
    <QrGenerator client:load />
  ) : slug === "image-compressor" ? (
    <ImageCompressor client:load />
  ) : slug === "document-scanner" ? (
    <DocumentScanner client:load />
  ) : (
    <div class="w-full p-12 rounded-2xl border border-dashed border-border text-center flex flex-col items-center justify-center gap-3 bg-surface">
      <h3 class="text-base font-bold text-text-primary">
        هذه الأداة قيد التطوير
      </h3>
      <p class="text-xs sm:text-sm text-text-secondary max-w-md">
        نعمل حالياً على إطلاق هذه الأداة وفق أعلى معايير الدقة والسرعة والخصوصية.
      </p>
    </div>
  )
}
