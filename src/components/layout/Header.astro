---
// Header.astro — pure static HTML, zero client JavaScript.
// Theme toggle button triggers are handled by a shared script in each page.
import { Icon } from "astro-icon/components";

const navLinks = [
  { href: "/", label: "الرئيسية" },
  { href: "/tools", label: "الأدوات" },
  { href: "/tool-guide", label: "أدلة الأدوات" },
  { href: "/about", label: "عن المنصة" },
];
const navLinkClass = "hover:text-text-primary text-sm transition-colors";
const activeLinkClass = "text-primary font-semibold";
const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-canvas/95 backdrop-blur-sm">
  <div
    class="max-w-285 mx-auto px-4 md:mt-10 sm:px-8 flex items-center justify-between h-16 gap-4"
  >
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-2.5 text-text-primary shrink-0"
      aria-label="آحاد — الرئيسية"
    >
      <span class="size-7 flex items-center justify-center text-text-primary">
        <Icon name="logo" class="size-6" />
      </span>
      <span class="text-xl font-bold tracking-tight">آحاد</span>
    </a>

    <!-- Desktop Navigation -->
    <div class="flex items-center gap-6 lg:gap-10">
      <nav
        class="hidden md:flex items-center gap-5 lg:gap-7"
        aria-label="التنقل الرئيسي"
      >
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class={`${
                navLinkClass +
                (pathname === link.href || pathname === link.href + "/"
                  ? activeLinkClass
                  : "font-medium text-text-secondary")
              }`}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-2">
        <!-- Theme Toggle Button -->
        <button
          id="themeToggleBtn"
          type="button"
          aria-label="تغيير المظهر"
          class="flex items-center justify-center rounded-xl size-9 bg-surface hover:bg-surface-subtle text-text-primary border border-border transition-colors cursor-pointer"
        >
          <!-- Moon icon — shown in light mode -->
          <Icon name="lucide:moon" class="dark:hidden size-4.5" />
          <!-- Sun icon — shown in dark mode -->
          <Icon name="lucide:sun" class="hidden dark:block size-4.5" />
        </button>

        <!-- Mobile Navigation -->
        <details class="relative md:hidden">
          <summary
            aria-label="فتح قائمة التنقل"
            class="list-none flex items-center justify-center rounded-xl size-9 bg-surface hover:bg-surface-subtle text-text-primary border border-border transition-colors cursor-pointer [&::-webkit-details-marker]:hidden"
          >
            <Icon name={"lucide:menu"} size={25} />
          </summary>

          <!-- Dropdown -->
          <nav
            aria-label="التنقل الرئيسي"
            class="absolute left-0 top-full mt-2 w-48 p-5 rounded-sm bg-canvas border border-border shadow-lg flex flex-col gap-3"
          >
            {
              navLinks.map((link) => (
                <a
                  href={link.href}
                  class={`${
                    navLinkClass +
                    (pathname === link.href || pathname === link.href + "/"
                      ? activeLinkClass
                      : "font-medium text-text-secondary")
                  }`}
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>
<script>
  // ── Theme Toggle ──────────────────────────────────────────────────────────
  const themeBtn = document.getElementById("themeToggleBtn");
  if (themeBtn) {
    themeBtn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("ahaad-theme", isDark ? "dark" : "light");
    });
  }
</script>
