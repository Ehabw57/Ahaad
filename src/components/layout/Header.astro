---
// Header.astro — pure static HTML, zero client JavaScript.
// Theme toggle button triggers are handled by a shared script in each page.
import { Icon } from "astro-icon/components";

const pathname = Astro.url.pathname;
const isAbout = pathname === "/about" || pathname === "/about/";
const isHome = !isAbout && (pathname === "/" || pathname === "");
const isFavorite =
  !isAbout && (pathname === "/favorite" || pathname === "/favorite/");
const isCategory =
  !isAbout && (pathname === "/#categories" || pathname === "/#categories/");
---

<header
  class="sticky top-0 z-40 bg-canvas/95 backdrop-blur-sm "
>
  <div
    class="max-w-285 mx-auto px-4 md:mt-10 sm:px-8 flex items-center justify-between h-16 gap-4"
  >
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-2.5 text-text-primary shrink-0"
      aria-label="آحاد — الرئيسية"
    >
      <span class="size-7 flex items-center justify-center text-text-primary">
        <Icon name="logo" class="size-6" />
      </span>
      <span class="text-xl font-bold tracking-tight">آحاد</span>
    </a>

    <!-- Desktop Navigation -->
    <div class="flex gap-20">
      <nav
        class="hidden md:flex items-center gap-8"
        aria-label="التنقل الرئيسي"
      >
        <a
          href="/"
          class={`text-sm transition-colors ${isHome ? "text-text-primary font-semibold" : "text-text-secondary hover:text-text-primary font-medium"}`}
        >
          الرئيسية
        </a>
        <a
          href="/#categories"
          class={`text-sm transition-colors ${isCategory ? "text-text-primary font-semibold" : "text-text-secondary hover:text-text-primary font-medium"}`}
        >
          التصنيفات
        </a>
        <a
          href="/about"
          class={`text-sm transition-colors ${isAbout ? "text-text-primary font-semibold" : "text-text-secondary hover:text-text-primary font-medium"}`}
        >
          عن المنصة
        </a>
        <a
          href="/favorite"
          class={`text-sm transition-colors ${isFavorite ? "text-text-primary font-semibold" : "text-text-secondary hover:text-text-primary font-medium"}`}
        >
          المفضله
        </a>
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-2">
        <!-- Theme Toggle Button -->
        <button
          id="themeToggleBtn"
          type="button"
          aria-label="تغيير المظهر"
          class="flex items-center justify-center rounded-xl size-9 bg-surface hover:bg-surface-subtle text-text-primary border border-border transition-colors cursor-pointer"
        >
          <!-- Moon icon — shown in light mode -->
          <Icon name="lucide:moon" class="dark:hidden size-4.5" />
          <!-- Sun icon — shown in dark mode -->
          <Icon name="lucide:sun" class="hidden dark:block size-4.5" />
        </button>

        <!-- Mobile Navigation -->
        <details class="relative md:hidden">
          <summary
            aria-label="فتح قائمة التنقل"
            class="list-none flex items-center justify-center rounded-xl size-9 bg-surface hover:bg-surface-subtle text-text-primary border border-border transition-colors cursor-pointer [&::-webkit-details-marker]:hidden"
          >
            <!-- Burger icon -->
            <span class="flex flex-col items-center justify-center gap-1">
              <span class="block w-4 h-0.5 bg-current rounded-full"></span>
              <span class="block w-4 h-0.5 bg-current rounded-full"></span>
              <span class="block w-4 h-0.5 bg-current rounded-full"></span>
            </span>
          </summary>

          <!-- Dropdown -->
          <nav
            aria-label="التنقل الرئيسي"
            class="absolute left-0 top-full mt-2 w-48 p-2 rounded-xl bg-canvas border border-border shadow-lg flex flex-col gap-1"
          >
            <a
              href="/"
              class="rounded-lg px-3 py-2.5 text-text-secondary hover:bg-surface hover:text-text-primary text-sm font-medium transition-colors"
            >
              الرئيسية
            </a>
            <a
              href="/#categories"
              class={`text-sm transition-colors ${isCategory ? "text-text-primary font-semibold" : "text-text-secondary hover:text-text-primary font-medium"}`}
            >
              التصنيفات
            </a>
            <a
              href="/about"
              class={`rounded-lg px-3 py-2.5 text-sm transition-colors ${isAbout ? "bg-surface-subtle text-text-primary font-semibold" : "text-text-secondary hover:bg-surface hover:text-text-primary font-medium"}`}
            >
              عن المنصة
            </a>
            <a
              href="/favorite"
              class={`text-sm transition-colors ${isFavorite ? "text-text-primary font-semibold" : "text-text-secondary hover:text-text-primary font-medium"}`}
            >
              المفضله
            </a>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>
<script>
  // ── Theme Toggle ──────────────────────────────────────────────────────────
  const themeBtn = document.getElementById("themeToggleBtn");
  if (themeBtn) {
    themeBtn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("ahaad-theme", isDark ? "dark" : "light");
    });
  }
</script>
