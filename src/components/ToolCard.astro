---
// ToolCard.astro — pure static HTML article card.
// Generated from tools.ts data. Zero client JavaScript.
// Constitution: semantic HTML, design tokens only, RTL logical properties.
import { Icon } from 'astro-icon/components';

interface Props {
  slug: string;
  title: string;
  shortDescription: string;
  icon: string;
  catId: string;
  /** Used to alternate icon badge style: even=filled (accent), odd=outlined (surface) */
  index: number;
}

const { slug, title, shortDescription, icon, catId, index } = Astro.props;

// Alternating icon styles per design reference (homepage.md)
const isFilledIcon = index % 2 === 0;

const iconBadgeClass = isFilledIcon
  ? 'bg-text-primary text-canvas'
  : 'bg-surface text-text-primary border border-border';
---

<article class="tool-card group" data-category={catId} data-name={`${title} ${shortDescription}`}>
  <a
    href={`/tools/${slug}`}
    class="flex flex-col p-5 sm:p-6 rounded-2xl border border-border bg-canvas hover:border-border-hover transition-colors duration-200 min-h-44 h-full"
  >
    <!-- Icon Badge -->
    <div class="mb-4">
      <div class={`w-12 h-12 flex items-center justify-center rounded-xl transition-transform duration-200 group-hover:scale-105 ${iconBadgeClass}`}>
        <Icon name={icon} class="w-6 h-6" />
      </div>
    </div>

    <!-- Content -->
    <h3 class="text-text-primary font-bold text-base mb-1.5 group-hover:text-accent transition-colors leading-snug">
      {title}
    </h3>
    <p class="text-text-secondary text-xs leading-relaxed line-clamp-2">
      {shortDescription}
    </p>
  </a>
</article>
