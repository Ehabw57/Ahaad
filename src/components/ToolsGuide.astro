---
import { Icon } from "astro-icon/components";
---
<section class="px-2 py-12" id="guides">
  <div class="rounded-2xl border border-border bg-surface p-6 sm:p-10 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 w-full">
      <div class="flex-1 max-w-xl text-right">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-surface-subtle text-text-primary text-xs font-semibold mb-3">
          <Icon name="lucide:library-big" size="18"/>
          <span>التوثيق والشروحات</span>
        </div>
        <h2 class="text-text-primary text-xl sm:text-2xl font-bold tracking-tight mb-2.5">دليل الأدوات والتوثيق الشامل</h2>
        <p class="text-text-secondary text-xs sm:text-sm leading-relaxed mb-6">لكل أداة في آحاد صفحة توثيق مفصلة تشرح طريقة الاستخدام المثلى، الآلية التقنية للمعالجة، والأسئلة الشائعة لضمان إنجاز مهامك بأعلى كفاءة وسرعة.</p>
        <a class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-accent text-accent-foreground hover:bg-accent-hover text-sm font-semibold transition-colors group" href="/tool-guide">
          <span>استكشف دليل الأدوات</span>

          <Icon name="lucide:arrow-left" size={18}/>
        </a>
      </div>
      <div class="w-full lg:w-auto shrink-0 flex flex-col gap-2.5">
        {[
          ["circle-check", "شروحات تفصيلية بالخطوات", "دليل خطوة بخطوة للوصول إلى أدق النتائج"],
          ["chart-pie", "توضيح قيود وحجم الملفات", "معرفة الحدود التقنية والصيغ المدعومة"],
          ["circle-question-mark", "أمثلة عملية وحالات استخدام", "تطبيقات حية لتسهيل سير أعمالك اليومية"],
        ].map(([icon, title, description]) => (
          <div class="flex items-center gap-3 p-3.5 rounded-md bg-surface-subtle border border-border">
            <span class="w-8 h-8 rounded-md bg-surface border border-border flex items-center justify-center text-text-primary shrink-0">
              <Icon name={"lucide:" + icon} size={19}/>
            </span>
            <div class="text-right">
              <span class="block text-xs font-semibold text-text-primary">{title}</span>
              <span class="block text-[11px] text-text-secondary">{description}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
