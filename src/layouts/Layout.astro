---
import "../global.css";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogType?: string;
  articleModifiedTime?: string;
  noindex?: boolean;
}

const {
  title = "آحاد — أدوات ويب عربية مفيدة وسريعة",
  description = "منصة عربية خفيفة وسريعة تجمع أدوات الويب اليومية المفيدة في مكان واحد بسيط وآمن.",
  canonicalURL = Astro.url.href,
  ogType = "website",
  articleModifiedTime,
  noindex = false,
} = Astro.props;

const siteName = "أَحاد";
const ogImage = "/og-image.jpg";
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Zero FOUC: run before render to apply saved/OS theme -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add("js");
        var stored = localStorage.getItem("ahaad-theme");
        var prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/IBMPlexSansArabic-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ar_SA" />
    {
      ogType === "article" && articleModifiedTime && (
        <meta property="article:modified_time" content={articleModifiedTime} />
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Generator tag -->
    <meta name="generator" content={Astro.generator} />

    <slot name="head" />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:inset-s-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-accent-foreground focus:rounded-lg focus:shadow-md"
    >
      الانتقال إلى المحتوى الرئيسي
    </a>

    {canonicalURL != "404" && <Header />}

    <slot />
    {canonicalURL != "404" && <Footer />}
  </body>
</html>
