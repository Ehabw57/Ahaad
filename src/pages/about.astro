---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const categories = [
  {
    name: "الحاسبات والمالية",
    icon: "lucide:calculator",
    href: "/#categories",
  },
  { name: "معالجة النصوص", icon: "lucide:file-text", href: "/#categories" },
  { name: "التاريخ والوقت", icon: "lucide:calendar", href: "/#categories" },
  { name: "تحويل الوسائط والصور", icon: "lucide:image", href: "/#categories" },
  {
    name: "محولات القياس والترميز",
    icon: "lucide:arrow-left-right",
    href: "/#categories",
  },
];

const facets = [
  {
    title: "وضوح الواجهة",
    description:
      "مساحات عمل خالية من الإعلانات والمشتتات البصرية، لتمنحك تركيزاً تاماً على المهمة المطلوبة.",
    icon: "lucide:layers",
  },
  {
    title: "سرعة الوصول",
    description:
      "الأداة جاهزة ومتاحة للعمل المباشر فور فتح الصفحة دون شاشات وسيطة أو تسجيل دخول إلزامي.",
    icon: "lucide:zap",
  },
  {
    title: "خصوصية البيانات",
    description:
      "الحسابات ومعالجات الملفات والنصوص تتم محلياً في متصفح جهازك لضمان عدم حفظ أو تخزين بياناتك.",
    icon: "lucide:shield-check",
  },
];
---

<Layout
  title="عن آحاد | أدوات رقمية متكاملة"
  description="آحاد يجمع الأدوات الرقمية المفيدة في مكان واحد، لتصل إلى ما تحتاجه بسهولة وتنجز مهامك اليومية دون خطوات غير ضرورية وبخصوصية تامة."
  activeNav="/about"
>

  <main class="w-full bg-canvas text-text-primary">
    <div class="max-w-285 px-4 sm:px-8 py-8 sm:py-12">

      <!-- Page Introduction -->
      <header class="max-w-3xl flex flex-col gap-3 pb-8">
        <h1
          class="text-3xl sm:text-4xl font-bold text-text-primary tracking-tight"
        >
          عن آحاد
        </h1>
        <p class="text-text-secondary text-base sm:text-lg leading-relaxed">
          آحاد يجمع الأدوات الرقمية المفيدة في مكان واحد، لتصل إلى ما تحتاجه
          بسهولة وتنجز مهامك اليومية دون خطوات غير ضرورية.
        </p>
      </header>

      <!-- Main Stream (lg:col-span-9) -->
      <div class="flex flex-col gap-2 my-5">
        <!-- Section 1: لماذا آحاد؟ -->
        <section id="why-ahaad" class=" flex flex-col gap-2">
          <div class="flex items-center gap-2.5">
            <span
              class="text-xs font-semibold text-text-primary bg-surface-subtle border border-border px-2 py-0.5 rounded-md font-mono"
            >
              01
            </span>
            <h2 class="text-xl sm:text-2xl font-bold text-text-primary">
              لماذا آحاد؟
            </h2>
          </div>
          <div class="max-w-2xl mt-1">
            <p class="text-text-secondary text-base sm:text-lg leading-relaxed">
              نؤمن أن الأدوات المفيدة يجب أن تكون واضحة وسهلة الوصول. لذلك نسعى
              إلى تقديم تجربة بسيطة تساعدك على إنجاز المهام اليومية بسرعة، دون
              تشتيت أو تعقيد.
            </p>
          </div>
        </section>

        <div class="w-full h-px bg-border/60"></div>

        <!-- Section 2: ماذا يقدم الموقع؟ -->
        <section id="what-we-offer" class="flex flex-col gap-4 scroll-mt-24">
          <div class="flex items-center gap-2.5">
            <span
              class="text-xs font-semibold text-text-primary bg-surface-subtle border border-border px-2 py-0.5 rounded-md font-mono"
            >
              02
            </span>
            <h2 class="text-xl sm:text-2xl font-bold text-text-primary">
              ماذا يقدم الموقع؟
            </h2>
          </div>
          <div class="max-w-2xl">
            <p class="text-text-secondary text-base sm:text-lg leading-relaxed">
              يضم آحاد مجموعة من الأدوات التي تساعدك في الحسابات والتعامل مع
              النصوص والتواريخ والصور والتحويلات وغيرها من المهام اليومية.
            </p>
          </div>

          <!-- Categorical Pills -->
          <div
            aria-label="أقسام الأدوات الرئيسية"
            class="flex flex-wrap gap-2.5 pt-2"
          >
            {
              categories.map((cat) => (
                <a
                  href={cat.href}
                  class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full bg-surface hover:bg-surface-subtle text-text-secondary hover:text-text-primary border border-border text-xs sm:text-sm font-medium transition-colors"
                >
                  <Icon name={cat.icon} class="size-4 text-accent" />
                  <span>{cat.name}</span>
                </a>
              ))
            }
          </div>
        </section>

        <div class="w-full h-px bg-border/60"></div>

        <!-- Section 3: تجربة استخدام بسيطة -->
        <section id="user-experience" class="flex flex-col gap-4 scroll-mt-24">
          <div class="flex items-center gap-2.5">
            <span
              class="text-xs font-semibold text-text-primary bg-surface-subtle border border-border px-2 py-0.5 rounded-md font-mono"
            >
              03
            </span>
            <h2 class="text-xl sm:text-2xl font-bold text-text-primary">
              تجربة استخدام بسيطة
            </h2>
          </div>
          <div class="max-w-2xl">
            <p class="text-text-secondary text-base sm:text-lg leading-relaxed">
              نركز على وضوح الواجهة، وسهولة الوصول إلى الأدوات، والتوافق مع
              مختلف أحجام الشاشات، مع الاهتمام بالخصوصية وتقليل العناصر غير
              الضرورية.
            </p>
          </div>

          <!-- Structured 3-row Facets List -->
          <div
            class="flex flex-col divide-y divide-border rounded-xl border border-border bg-surface overflow-hidden mt-1"
          >
            {
              facets.map((facet) => (
                <div class="p-4 sm:p-5 flex flex-col md:flex-row md:items-baseline justify-between gap-2.5 md:gap-6">
                  <div class="flex items-center gap-2.5 shrink-0 md:w-52">
                    <Icon name={facet.icon} class="size-5 text-accent" />
                    <span class="text-base font-semibold text-text-primary">
                      {facet.title}
                    </span>
                  </div>
                  <p class="text-sm sm:text-base text-text-secondary leading-relaxed grow">
                    {facet.description}
                  </p>
                </div>
              ))
            }
          </div>
        </section>

        <div class="w-full h-px bg-border/60"></div>

        <!-- Section 4: رؤيتنا -->
        <section id="vision" class="flex flex-col gap-4 scroll-mt-24">
          <div class="flex items-center gap-2.5">
            <span
              class="text-xs font-semibold text-text-primary bg-surface-subtle border border-border px-2 py-0.5 rounded-md font-mono"
            >
              04
            </span>
            <h2 class="text-xl sm:text-2xl font-bold text-text-primary">
              رؤيتنا
            </h2>
          </div>

          <!-- Tinted Surface Card -->
          <div
            class="p-5 sm:p-6 rounded-xl border border-border bg-surface flex flex-col gap-2.5"
          >
            <div class="flex items-center gap-2 text-accent">
              <Icon name="lucide:lightbulb" class="size-5" />
              <span class="text-sm font-bold">المسار المستمر</span>
            </div>
            <p
              class="text-base sm:text-lg text-text-primary leading-relaxed max-w-2xl font-medium"
            >
              أن يكون آحاد وجهة عربية عملية للأدوات الرقمية، تتطور باستمرار وفق
              احتياجات المستخدمين.
            </p>
          </div>
        </section>

        <!-- Restrained Minimalist Call to Action (Home Link) -->
        <div class="pt-4 flex items-center justify-between flex-wrap gap-4">
          <a
            href="/"
            class="inline-flex items-center gap-2.5 px-6 py-3 rounded-xl bg-accent hover:bg-accent-hover text-accent-foreground text-sm font-semibold transition-all duration-150 group shadow-xs active:scale-[0.99]"
          >
            <span>استكشف الأدوات المتاحة في آحاد</span>
            <Icon
              name="lucide:arrow-left"
              class="size-4 transform group-hover:-translate-x-1 transition-transform"
            />
          </a>
        </div>
      </div>
    </div>
  </main>

</Layout>
