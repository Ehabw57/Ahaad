---
import Layout from "../layouts/Layout.astro";
import { TOOLS } from "../data/tools.ts";
import SearchTools from "../components/SearchTools";

const publishedTools = TOOLS.filter((t) => t.published);
---

<Layout>
    <main class="min-h-svh md:px-16 lg:px-24 xl:px-36 py-5 sm:py-7"  >
      <div class="max-w-285 mx-auto">
        <!-- Hero + Search -->
        <section class="pt-12 pb-7 px-2 text-center max-w-2xl mx-auto w-full">
          <!-- Page heading -->
          <h1
            class="text-text-primary tracking-tight text-3xl sm:text-4xl font-bold leading-tight pb-3"
          >
            أدوات عملية وبسيطة، في مكان واحد
          </h1>
          <p
            class="text-text-secondary text-sm sm:text-base font-normal leading-relaxed pb-7 text-center"
          >
            مجموعة أدوات مفيدة وسريعة، مُصممة للتركيز والعمل المباشر دون تعقيد.
          </p>
        </section>
        <SearchTools client:idle />
      </div>
    </main>
</Layout>
<script></script>
