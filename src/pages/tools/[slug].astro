---
import Layout from "../../layouts/Layout.astro";
import ToolShell from "../../components/ToolShell.astro";
import ToolRendrer from "../../components/ToolRendrer.astro";
import { getCollection } from "astro:content";
import { TOOLS } from "../../data/tools.ts";
import type { Tool } from "../../types/index.ts";

export async function getStaticPaths() {
  const guides = await getCollection("tool-guides");
  const guideSlugSet = new Set(guides.map((g) => g.id));
  const publishedTools = TOOLS.filter((t) => t.published);
  return publishedTools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool, hasGuide: guideSlugSet.has(tool.slug) },
  }));
}

interface Props {
  tool: Tool;
  hasGuide: boolean;
}

const { tool, hasGuide } = Astro.props;
---

<Layout
  title={`${tool.title} | آحاد`}
  description={tool.metaDescription || tool.shortDescription}
>
  <div class="flex flex-col min-h-svh">
    <main id="main-content" class="flex-1 w-full bg-canvas text-text-primary">
      <ToolShell
        slug={tool.slug}
        title={tool.title}
        shortDescription={tool.shortDescription}
        toolDescription={tool.metaDescription}
        catId={tool.catId}
        icon={tool.iconName}
        hasGuide={hasGuide}
      >
        <ToolRendrer slug={tool.slug} />
      </ToolShell>
    </main>
  </div>
</Layout>
