---
import Layout from "../../layouts/Layout.astro";
import ToolShell from "../../components/ToolShell.astro";
import AgeCalculator from "../../tools/age-calculator/AgeCalculator.tsx";
import QrGenerator from "../../tools/qr-generator/QrGenerator.tsx";
import ImageCompressor from "../../tools/image-compressor/ImageCompressor.tsx";
import DocumentScanner from "../../tools/document-scanner/DocumentScanner.tsx";
import { TOOLS } from "../../data/tools.ts";
import type { Tool } from "../../types/index.ts";

export function getStaticPaths() {
  const publishedTools = TOOLS.filter((t) => t.published);
  return publishedTools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<Layout
  title={`${tool.title} | آحاد`}
  description={tool.metaDescription || tool.shortDescription}
>
  <div class="flex flex-col min-h-svh">
    <main class="flex-1 w-full bg-canvas text-text-primary">
      <ToolShell
        slug={tool.slug}
        title={tool.title}
        shortDescription={tool.shortDescription}
        toolDescription={tool.metaDescription}
        catId={tool.catId}
        icon={tool.icon}
      >
        {
          tool.slug === "age-calculator" ? (
            <AgeCalculator client:load />
          ) : tool.slug === "qr-generator" ? (
            <QrGenerator client:load />
          ) : tool.slug === "image-compressor" ? (
            <ImageCompressor client:load />
          ) : tool.slug === "document-scanner" ? (
            <DocumentScanner client:load />
          ) : (
            <div class="w-full p-12 rounded-2xl border border-dashed border-border text-center flex flex-col items-center justify-center gap-3 bg-surface">
              <h3 class="text-base font-bold text-text-primary">
                هذه الأداة قيد التطوير
              </h3>
              <p class="text-xs sm:text-sm text-text-secondary max-w-md">
                نعمل حالياً على إطلاق هذه الأداة وفق أعلى معايير الدقة والسرعة
                والخصوصية.
              </p>
            </div>
          )
        }
      </ToolShell>
    </main>
  </div>
</Layout>
